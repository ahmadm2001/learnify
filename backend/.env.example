# Learnify backend configuration
# Copy this file to .env and fill in your own values.
# The real .env is git-ignored and must never be committed.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL 14+
DB_NAME=fyp
DB_USER=fyp_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Judge0, sandboxed code execution (self-hosted or RapidAPI)
JUDGE0_URL=http://localhost:2358

# Zoom, live sessions (server-to-server OAuth app)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# SMTP, transactional email
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# OpenAI, course AI tutor
OPENAI_API_KEY=
